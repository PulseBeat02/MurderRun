{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "ignoreTests": true,
  "packageRules": [
    {
      "matchDatasources": ["maven"],
      "versioning": "semver"
    },
    {
      "description": "Jupyter Book 2 removed 'jupyter-book config sphinx', which .readthedocs.yaml runs",
      "matchPackageNames": ["jupyter-book"],
      "allowedVersions": "<2"
    }
  ]
}
